<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign in • MyTube</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/signin.css" />
  <link rel="stylesheet" href="/css/flash.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
</head>

<body>

  <%- include("../includes/flash.ejs") %>

  <!-- Back button -->
  <div id="back">
    <a href="<%= returnTo || '/videos' %>" style="text-decoration: none">
      <div id="back-arrow">
        <i class="bi bi-arrow-left-circle"></i>
      </div>
    </a>
  </div>

  <% if (error && error.length > 0) { %>
  <div class="alert alert-danger">
    <%= error[0] %>
  </div>
  <% } %>

  <!-- Signin Card -->
  <div class="signinpage">
    <!-- Icon -->
    <div class="googlelogo">
      <div class="googleicon">
        <i class="bi bi-person-circle"></i>
      </div>
    </div>

    <!-- Content -->
    <form class="signin-form needs-validation" method="POST" action="/login" novalidate>
      <div class="block1">
        <div class="signinst">
          <div class="signinst1">Sign in</div>
          <div class="signinst2">to continue to MyTube</div>
        </div>

        <input type="hidden" name="returnTo" value="<%= returnTo %>" />

        <div class="signin-info">
          <div class="signininput">
            <input class="inputbox" type="text" name="username" placeholder="Username" required />
            <div class="invalid-feedback">
              Username is required
            </div>
          </div>

          <div class="signininput password-box">
            <input class="inputbox" type="password" name="password" placeholder="Password" required />
            <div class="invalid-feedback">
              Password is required
            </div>
          </div>

          <div class="forgot-email">
            Forgot password?
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="block2">
        <a href="/signup" class="createaccount">
          Create account
        </a>

        <button type="submit" class="next">
          Next
        </button>
      </div>

      <div class="divider">
        <span>or</span>
      </div>

      <!-- Google Login -->
      <a href="/auth/google?returnTo=<%= encodeURIComponent(returnTo || '/videos') %>" class="google-btn">
        <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google" />
        Sign in with Google
      </a>
    </form>
  </div>
</body>

</html>

<script src="/js/validate.js"></script>