<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create account • MyTube</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/signin.css" />
  <link rel="stylesheet" href="/css/flash.css" />
</head>

<body>

  <%- include("../includes/flash.ejs") %>

  <!-- Back button -->
  <div id="back">
    <a href="<%= returnTo || '/videos' %>" style="text-decoration: none">
      <div id="back-arrow">
        <i class="bi bi-arrow-left-circle"></i>
      </div>
    </a>
  </div>

  <!-- Signup Card -->
  <div class="signinpage">
    <!-- Icon -->
    <div class="googlelogo">
      <div class="googleicon">
        <i class="bi bi-person-plus-fill"></i>
      </div>
    </div>

    <form class="signin-form needs-validation" method="POST" action="/signup" enctype="multipart/form-data" novalidate>
      <!-- Heading -->
      <div class="block1">
        <div class="signinst">
          <div class="signinst1">Create account</div>
          <div class="signinst2">Join MyTube today</div>
        </div>

        <!-- Inputs -->
        <div class="signin-info">

          <input type="hidden" name="returnTo" value="<%= returnTo %>" />

          <!-- Username -->
          <div class="signininput">
            <input class="inputbox" type="text" name="username" placeholder="Full name" required minlength="3" />
            <div class="invalid-feedback">
              Name must be at least 3 characters long
            </div>
          </div>

          <!-- Email -->
          <div class="signininput">
            <input class="inputbox" type="email" name="email" placeholder="Email address" required />
            <div class="invalid-feedback">
              Please enter a valid email address
            </div>
          </div>

          <!-- Password -->
          <div class="signininput">
            <input class="inputbox" type="password" name="password" placeholder="Create password" required minlength="6" />
            <div class="invalid-feedback">
              Password must be at least 6 characters
            </div>
          </div>

          <!-- Profile Picture -->
          <div class="file-upload">
            <label>Profile picture (optional)</label>
            <input type="file" name="profileUrl" accept="image/*" />
          </div>

          <!-- Background Image -->
          <div class="file-upload">
            <label>Background image (optional)</label>
            <input type="file" name="backgroundImage" accept="image/*" />
          </div>

        </div>
      </div>

      <!-- Footer -->
      <div class="block2">
        <a href="/login" class="createaccount">
          Already have an account?
        </a>

        <button type="submit" class="next">
          Sign up
        </button>
      </div>

      <div class="divider">
        <span>or</span>
      </div>

      <!-- Google Signup -->
      <a href="/auth/google?returnTo=<%= encodeURIComponent(returnTo || '/videos') %>" class="google-btn">
        <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google" />
        Sign up with Google
      </a>
    </form>
  </div>
  <script src="/js/validate.js"></script>
</body>

</html>