<% layout("/layouts/boilerplate") %>

<div id="videosidebar">
  <%- include("../includes/sidebar.ejs") %>
</div>

<div class="upload-page">

  <h2>Create Community Post</h2>

  <form action="/upload/post" method="POST" class="upload-form" enctype="multipart/form-data">
    <div class="form-group">
      <label>Enter Description</label>
      <textarea name="content" placeholder="Share something with your community..." style="height: 100px !important;" required></textarea>
    </div>

    <div class="form-group">
      <label>Upload Image</label>
      <input type="file" name="image" id="thumbnail" accept="image/*" required />
      <div class="form-hint" style="margin-top: 8px;">JPG, PNG — recommended 1:1</div>
      <img id="thumbPreview" class="thumbnail-preview" />
    </div>

    <button type="submit" class="btn-primary">
      Post
    </button>

  </form>

</div>

<script src="/js/videosidebar.js"></script>
<script src="/js/preview.js"></script>