<% layout("/layouts/boilerplate") %>

<div id="videosidebar">
  <%- include("../includes/sidebar.ejs") %>
</div>

<div class="upload-page">

  <h2>Upload Video</h2>
  <form action="/upload/video" method="POST" class="upload-form" enctype="multipart/form-data">
    <!-- TITLE -->
    <div class="form-group">
      <label>Title *</label>
      <input type="text" name="title" required />
    </div>

    <!-- DESCRIPTION -->
    <div class="form-group">
      <label>Description</label>
      <textarea name="description" rows="4"></textarea>
    </div>

    <!-- VIDEO FILE -->
    <div class="form-group">
      <label style="margin-bottom: 0px;">Video File *</label>
      <span style="margin-bottom: 10px;"><small>(Maximum size: 10 MB)</small></span>
      <input type="file" name="video" accept="video/*" required />
    </div>

    <!-- THUMBNAIL FILE -->
    <div class="form-group">
      <label>Thumbnail</label>
      <input type="file" name="thumbnail" id="thumbnail" accept="image/*" required/>
      <img id="thumbPreview" class="thumbnail-preview" style="display: none; margin-top: 10px; max-width: 200px; border-radius: 8px;" />
    </div>

    <!-- CATEGORY -->
    <div class="form-group">
      <label>Category *</label>
      <select name="category" required>
        <option value="">Select category</option>
        <option value="Education">Education</option>
        <option value="Entertainment">Entertainment</option>
        <option value="Technology">Technology</option>
        <option value="Programming">Programming</option>
        <option value="Music">Music</option>
        <option value="Gaming">Gaming</option>
        <option value="Sports">Sports</option>
        <option value="Travel">Travel</option>
        <option value="Food">Food</option>
        <option value="Lifestyle">Lifestyle</option>
      </select>
    </div>

    <button type="submit" class="btn-primary">
      Upload Video
    </button>
  </form>
</div>

<script src="/js/videosidebar.js"></script>
<script src="/js/preview.js" ></script>